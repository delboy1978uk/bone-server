{
    "name": "delboy1978uk/bone-server",
    "description": "Server package for Bone Framework",
    "license": "MIT",
    "authors": [
        {
            "name": "Derek Stephen McLean",
            "email": "delboy1978uk@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "delboy1978uk/barnacle": "^v2.4",
        "delboy1978uk/session": "^v1.6"
    },
    "require-dev": {
        "roave/security-advisories": "dev-latest",
        "delboy1978uk/dev-tools": "^1.1"
    },
    "autoload": {
        "psr-4": {
            "Bone\\Server\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BoneTest\\": "tests/unit/"
        }
    },
    "config": {
        "allow-plugins": {
            "phpro/grumphp": false
        }
    }
}
